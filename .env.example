# LLM·VLM 공급자: mock | gemini | ollama  (기본 mock = 키 없이 데모 모드)
LLM_PROVIDER=mock

# 모델명은 코드에 하드코딩하지 않음. gemini/ollama 사용 시 반드시 지정
# 예) gemini: Google AI Studio 모델 목록에서 확인한 Gemini 멀티모달 모델명
#     ollama: `ollama list`로 확인한 모델명 (VLM은 비전 지원 모델)
LLM_MODEL=
VLM_MODEL=

# Gemini (선택)
GOOGLE_API_KEY=

# Ollama (선택)
OLLAMA_BASE_URL=http://localhost:11434

# Embedding (로컬 sentence-transformers, API 키 불필요)
# intfloat/multilingual-e5-small (기본) | BAAI/bge-m3
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# RAG 유사도 임계값(0~1, cosine relevance). 임계값 미만이면 "문서 근거 없음"
RAG_SCORE_THRESHOLD=0.80

# KAMIS Open API (선택. 없으면 파일/샘플 사용)
KAMIS_API_KEY=
KAMIS_API_ID=
